{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:security && npm run test:rules",
    "test:security": "npm run build && node scripts/security-smoke.cjs",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project mealoo-rules-test --only firestore,storage \"mocha test/firebase-rules.test.cjs\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cheerio": "^1.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "ipaddr.js": "^2.5.0",
    "openai": "^7.30.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "mocha": "^12.0.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "private": true
}
